# TRACE-X Frontend Environment Configuration Template
# Copy this file to .env or configure in your deployment platform (Vercel, Netlify, Cloudflare Pages, etc.)

# API Base URL for backend communication
# Development default: http://127.0.0.1:8000
# Production example (same domain behind reverse proxy): Leave empty or set to relative path ""
# Production example (separate subdomain): https://api.tracex.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Canonical Public Website URL (used for sitemap, canonical links, and social Open Graph preview URLs)
# Example: https://tracex.example.com
VITE_SITE_URL=https://tracex.example.com

# Google Analytics 4 Measurement ID (Optional)
# Format: G-XXXXXXXXXX
# When omitted, analytics tracking is completely disabled.
# Do not invent a dummy ID; configure only after provisioning a property in Google Analytics.
VITE_GA_MEASUREMENT_ID=
