# TRACE-X Telemetry Edge Agent Configuration (Example)
# Copy to .env or export into your environment.

# TRACE-X Platform API Endpoint
TRACEX_API_URL=http://127.0.0.1:8000

# Device ID (The numeric ID of your registered device in TRACE-X)
TRACEX_DEVICE_ID=1

# Authentication Option A: Bearer JWT Token directly
# TRACEX_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authentication Option B: Account credentials (Agent will authenticate automatically)
TRACEX_EMAIL=user@example.com
TRACEX_PASSWORD=your_secure_password

# GPS Hardware Source: auto | gpsd | serial | manual
#   auto   : Auto-detects local gpsd or serial NMEA port
#   gpsd   : Standard Linux GPS daemon via TCP socket
#   serial : Direct serial NMEA receiver (e.g., USB GPS dongle)
#   manual : Prompt for real hardware instrument readings
GPS_SOURCE=auto

# Serial GPS Settings (used if GPS_SOURCE=serial or auto-detected)
GPS_SERIAL_PORT=/dev/ttyUSB0
GPS_SERIAL_BAUDRATE=9600

# Linux gpsd Settings (used if GPS_SOURCE=gpsd or auto-detected)
GPSD_HOST=127.0.0.1
GPSD_PORT=2947

# Telemetry transmission interval in seconds
TELEMETRY_INTERVAL=10
