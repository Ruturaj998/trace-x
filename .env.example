# ==============================================================================
# TRACE-X Backend Environment Configuration (Production Template)
# ==============================================================================
# Copy this file to .env and customize for your deployment environment.
# NEVER commit real credentials, secrets, or JWT keys to source control.
# ==============================================================================

# Environment Mode: development | production
ENVIRONMENT=development

# Database Connection URL (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
DATABASE_URL=postgresql+psycopg://trace_x_user:trace_x_dev_password@localhost:5432/trace_x

# JWT Secret Key (Generate a cryptographically secure random string with: openssl rand -hex 32)
SECRET_KEY=your-secure-jwt-secret-key-at-least-32-bytes-long

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated list of origins)
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production: https://tracex.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Trusted Reverse Proxy IP Addresses / CIDRs (Comma-separated)
# Forwarding headers (X-Forwarded-For, X-Real-IP) are ONLY inspected when direct peer matches these addresses.
# Default: 127.0.0.1,::1
TRUSTED_PROXIES=127.0.0.1,::1

# Production SMTP Email Configuration (Optional - in development, reset links log to console)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=true
# SMTP_SSL=false
# EMAIL_FROM=security@tracex.example.com

# Server Process & Concurrency Settings (Optional)
# GUNICORN_BIND=127.0.0.1:8000
# WEB_CONCURRENCY=4
# LOG_LEVEL=info
