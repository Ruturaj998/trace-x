# TRACE-X Backend Environment Configuration (Example Template)
# Copy this file to .env and customize for your environment.
# NEVER commit the real .env file or real secrets to source control.

# Environment Mode: development | production
ENVIRONMENT=development

# Database connection URL (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/trace_x

# JWT Secret Key (Generate a cryptographically secure random string with: openssl rand -hex 32)
SECRET_KEY=your-secure-jwt-secret-key-at-least-32-bytes-long

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated list of origins)
# For local development: http://localhost:5173,http://127.0.0.1:5173
# For production: https://tracex.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Production SMTP Email Configuration (Optional - in development, reset links are logged to console)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=true
# SMTP_SSL=false
# EMAIL_FROM=security@tracex.example.com
